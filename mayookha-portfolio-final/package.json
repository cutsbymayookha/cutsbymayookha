{
  "name": "mayookha-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "validate:assets": "tsx scripts/validate-assets.ts",
    "validate:dist": "tsx scripts/validate-assets.ts --check-dist",
    "build": "npm run validate:assets && vite build && npm run ensure:hostinger && npm run validate:dist",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "ensure:hostinger": "node scripts/ensure-hostinger-htaccess.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
